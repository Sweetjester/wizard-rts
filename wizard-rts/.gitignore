# Godot 4+ specific ignores
.godot/
/android/

# Python
__pycache__/

# Local secrets and generated PixelLab outputs
.env
.env.*
!*.example
assets/generated/pixellab/
assets/review/pixellab/
tools/pixellab/jobs/
tools/pixellab/terrain_jobs/
tools/pixellab/openapi_cache.json

# Raw/intermediate prop pipeline output (regeneratable from props/specs/*.yaml;
# only the final assets_game/ runtime GLBs are committed)
art/generated_props/
art/processed_props/

# Local telemetry exports from playtests
test_exports/session_data/*
!test_exports/session_data/.gitkeep
