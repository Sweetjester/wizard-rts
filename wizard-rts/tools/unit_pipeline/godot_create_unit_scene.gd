func _create_projectile(spec: Dictionary) -> void:
	var projectile_id := "%s_projectile" % str(spec.get("unit_id", "unit"))
	var dir := "res://game/projectiles/generated/%s" % projectile_id
	_ensure_dir(dir)
	_write_text("%s/%s.gd" % [dir, projectile_id], GENERATED_WARNING + "extends Node3D\n\n@export var speed := 12.0\n@export var damage := %s\n" % str(spec.get("combat.damage", 1)))
	_write_text("%s/%s.tscn" % [dir, projectile_id], "[gd_scene load_steps=2 format=3]\n\n[ext_resource type=\"Script\" path=\"%s/%s.gd\" id=\"1_script\"]\n\n[node name=\"%s\" type=\"Node3D\"]\nscript = ExtResource(\"1_script\")\n" % [dir, projectile_id, projectile_id.capitalize()])

func _import_report_text(spec: Dictionary, report: Dictionary) -> String:
	var lines := []
	lines.append("# Import Report: %s" % str(spec.get("display_name", spec.get("unit_id", ""))))
	lines.append("")
	lines.append("- Meshy called: %s" % ("yes" if bool(report.get("meshy_called", false)) else "no"))
	lines.append("- Raw model path: %s" % str(report.get("raw_model_path", "")))
	lines.append("- Processed GLB path: %s" % str(report.get("processed_glb_path", "")))
	lines.append("- Godot scene path: %s" % str(report.get("godot_scene_path", "")))
	lines.append("")
	lines.append("## Generated Scripts/Resources")
	for item in report.get("generated", []):
		lines.append("- %s" % str(item).trim_prefix("res://"))
	lines.append("")
	lines.append("## Warnings")
	var warnings: Array = report.get("warnings", [])
	if warnings.is_empty():
		lines.append("- None")
	else:
		for item in warnings:
			lines.append("- %s" % str(item))
	lines.append("")
	lines.append("## Manual Cleanup TODOs")
	for item in report.get("manual_todos", []):
		lines.append("- %s" % str(item))
	lines.append("")
	lines.append("## Animation Status")
	var animation_status: Dictionary = report.get("animation_status", {})
	for key in animation_status.keys():
		lines.append("- %s: %s" % [str(key), str(animation_status[key])])
	lines.append("")
	lines.append("## Errors Encountered")
	var errors: Array = report.get("errors", [])
	if errors.is_empty():
		lines.append("- None")
	else:
		for item in errors:
			lines.append("- %s" % str(item))
	return "\n".join(lines) + "\n"
