extends SceneTree

const GENERATED_WARNING := "# Generated by tools/unit_pipeline. Edit the YAML and rerun the pipeline for repeatable changes.\n"

var _args := {}
var _force := false

func _init() -> void:
	_parse_args()
	var exit_code := _run()
	quit(exit_code)

func _parse_args() -> void:
	var argv := OS.get_cmdline_user_args()
	var i := 0
	while i < argv.size():
		var key := str(argv[i])
		if key == "--force":
			_force = true
			i += 1
			continue
		if key.begins_with("--") and i + 1 < argv.size():
			_args[key.trim_prefix("--")] = str(argv[i + 1])
			i += 2
			continue
		i += 1

func _run() -> int:
	if not _args.has("spec") or not _args.has("processed-glb") or not _args.has("report-json"):
		push_error("Expected --spec, --processed-glb and --report-json.")
		return 2
	var spec := _read_simple_yaml(_absolute_to_project_path(_args["spec"]))
	var unit_id := str(spec.get("unit_id", ""))
	if unit_id.is_empty():
		push_error("Spec missing unit_id.")
		return 2
	var processed_glb := _absolute_to_project_path(_args["processed-glb"])
	var report_json_path := _absolute_to_project_path(_args["report-json"])
	var unit_dir := "res://game/units/generated/%s" % unit_id
	var data_dir := "res://game/data/units"
	_ensure_dir(unit_dir)
	_ensure_dir(data_dir)
	var scene_path := "%s/%s.tscn" % [unit_dir, unit_id]
	var script_path := "%s/%s.gd" % [unit_dir, unit_id]
	var data_path := "%s/%s.tres" % [data_dir, unit_id]
	var data_script_path := "%s/generated_unit_data.gd" % data_dir
	var report_path := "%s/IMPORT_REPORT.md" % unit_dir
	if not _force:
		for path in [scene_path, script_path, data_path, report_path]:
			if FileAccess.file_exists(path):
				push_error("%s exists. Rerun with --force to overwrite generated files." % path)
				return 3
	var report := _load_json(report_json_path)
	if _force or not FileAccess.file_exists(data_script_path):
		_write_text(data_script_path, _unit_data_script_text())
	_write_text(script_path, _unit_script_text(spec))
	_write_text(data_path, _unit_data_text(spec))
	_write_text(scene_path, _scene_text(spec, processed_glb, script_path))
	if str(spec.get("combat.attack_type", "")) == "projectile":
		_create_projectile(spec)
	var generated := [scene_path, script_path, data_path, data_script_path, report_path]
	report["generated"] = generated
	report["godot_scene_path"] = scene_path.trim_prefix("res://")
	_write_text(report_json_path, JSON.stringify(report, "\t"))
	_write_text(report_path, _import_report_text(spec, report))
	return 0

func _absolute_to_project_path(path_value: String) -> String:
	var path := path_value.replace("\\", "/")
	var root := ProjectSettings.globalize_path("res://").replace("\\", "/").rstrip("/")
	if path.begins_with(root):
		return "res://" + path.substr(root.length()).trim_prefix("/")
	if path.begins_with("res://"):
		return path
	return path

func _ensure_dir(path: String) -> void:
	var dir := DirAccess.open("res://")
	var relative := path.trim_prefix("res://")
	dir.make_dir_recursive(relative)

func _write_text(path: String, content: String) -> void:
	var file := FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		push_error("Could not write %s: %s" % [path, error_string(FileAccess.get_open_error())])
		return
	file.store_string(content)

func _read_text(path: String) -> String:
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		return ""
	return file.get_as_text()

func _load_json(path: String) -> Dictionary:
	var text := _read_text(path)
	if text.is_empty():
		return {}
	var parsed = JSON.parse_string(text)
	return parsed if typeof(parsed) == TYPE_DICTIONARY else {}

func _read_simple_yaml(path: String) -> Dictionary:
	var result := {}
	var stack: Array = [result]
	var indents: Array[int] = [0]
	for raw_line in _read_text(path).split("\n"):
		var line := raw_line.rstrip("\r")
		if line.strip_edges().is_empty() or line.strip_edges().begins_with("#"):
			continue
		var indent := line.length() - line.strip_edges(true, false).length()
		while indents.size() > 1 and indent <= indents[indents.size() - 1]:
			indents.pop_back()
			stack.pop_back()
		var trimmed := line.strip_edges()
		if trimmed.begins_with("- "):
			continue
		var colon := trimmed.find(":")
		if colon < 0:
			continue
		var key := trimmed.substr(0, colon).strip_edges()
		var value_text := trimmed.substr(colon + 1).strip_edges()
		var parent: Dictionary = stack[stack.size() - 1]
		var full_key := key
		if stack.size() > 1:
			var prefix := str(parent.get("__prefix", ""))
			full_key = "%s.%s" % [prefix, key] if not prefix.is_empty() else key
		if value_text.is_empty():
			var child := {"__prefix": full_key}
			parent[key] = child
			result[full_key] = child
			stack.append(child)
			indents.append(indent)
		else:
			var value = _parse_yaml_scalar(value_text)
			parent[key] = value
			result[full_key] = value
	return result

func _parse_yaml_scalar(value_text: String):
	if value_text == "true":
		return true
	if value_text == "false":
		return false
	if value_text == "[]":
		return []
	if value_text.is_valid_int():
		return int(value_text)
	if value_text.is_valid_float():
		return float(value_text)
	return value_text.trim_prefix("\"").trim_suffix("\"")

func _display_class_name(display_name: String) -> String:
	var output := ""
	for part in display_name.split(" "):
		output += part.capitalize().replace("_", "")
	return output

func _unit_script_text(spec: Dictionary) -> String:
	return GENERATED_WARNING + """extends Node3D

@export var unit_id := "%s"
@export var hp := %s
@export var speed := %s
@export var armor := %s
@export var sight_range := %s
@export var attack_range := %s
@export var damage := %s
@export var cooldown := %s
@export var faction := "%s"
@export var movement_type := "%s"
@export var attack_type := "%s"
@export var idle_animation := "idle"
@export var move_animation := "move"
@export var attack_animation := "attack"
@export var death_animation := "death"

var current_hp := hp
var cooldown_remaining := 0.0

func _ready() -> void:
	current_hp = hp
	# TODO: Bridge this generated Node3D unit to the existing RTSUnit/CombatSystem runtime.

func _process(delta: float) -> void:
	cooldown_remaining = maxf(0.0, cooldown_remaining - delta)

func can_attack() -> bool:
	return cooldown_remaining <= 0.0

func mark_attack_started() -> void:
	cooldown_remaining = cooldown

func take_damage(amount: int, _source: Node = null) -> void:
	current_hp = maxi(0, current_hp - maxi(0, amount - armor))
	if current_hp <= 0:
		queue_free()
""" % [
		str(spec.get("unit_id", "")),
		str(spec.get("stats.hp", 1)),
		str(spec.get("movement.speed", 1.0)),
		str(spec.get("stats.armor", 0)),
		str(spec.get("stats.sight_range", 0)),
		str(spec.get("combat.range", 0)),
		str(spec.get("combat.damage", 0)),
		str(spec.get("combat.cooldown", 1.0)),
		str(spec.get("faction", "")),
		str(spec.get("movement.type", "")),
		str(spec.get("combat.attack_type", "")),
	]

